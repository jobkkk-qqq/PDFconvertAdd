# 打包产物与构建目录
build/
dist/
**/dist/
*.spec.bak

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 文档/图片样本与隐私文件（发票、简历等，不进入公共仓库）
*.pdf
*.PDF
*.xlsx
*.xls
*.png
*.jpg
*.jpeg
*.bmp
*.gif
!**/icons/*.ico

# 测试辅助脚本与报告（非交付源码）
_t_*.py
_verify_*.py
run_tests.py
test_all.py
verify_tests.py
*_test_report.txt
comprehensive_test_report.txt
final_test_report.txt
test_report.txt
verification_report.txt
edit_test/

# ZCode / 工具生成目录
.zcode/
.trae-html-share-packages/
pdf-converter-review/

# 临时文件
*.tmp
*.log
Thumbs.db

# 许可签名私钥（Ed25519 发码用）——绝不入库、绝不进 exe。
# 程序里只放公钥；私钥只留在开发者本机（默认放在仓库外的 license-keys/ 目录）。
license-private-key.json
*private-key*.json
license-keys/